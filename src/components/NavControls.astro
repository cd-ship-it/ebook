---
interface Props {
  prevHref?: string;
  nextHref: string;
  current: number;
  total: number;
  isLast: boolean;
}

const { prevHref, nextHref, current, total, isLast } = Astro.props;
---

<nav class="nav-controls" aria-label="Page navigation">
  {
    prevHref ? (
      <a class="nav-btn nav-prev" href={prevHref}>‹ Back</a>
    ) : (
      <span class="nav-btn nav-prev is-disabled" aria-hidden="true">‹ Back</span>
    )
  }
  <span class="nav-indicator">{current} / {total}</span>
  <a class="nav-btn nav-next" href={nextHref}>{isLast ? 'Restart ↺' : 'Next ›'}</a>
</nav>
