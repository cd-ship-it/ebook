---
import ContentDialog from './ContentDialog.astro';

interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<button type="button" class="read-more-btn" data-read-more-open={id} aria-haspopup="dialog">
  {label}
</button>

<ContentDialog id={id}>
  <slot />
</ContentDialog>
