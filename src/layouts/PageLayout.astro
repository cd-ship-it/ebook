---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import NavDock from '../components/NavDock.astro';
import ExternalLink from '../components/ExternalLink.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import { cacheBustUrl } from '../utils/cacheBust';
import { pageHref } from '../utils/paths';

interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  subtitle?: string;
  layout: 'cover' | 'content' | 'fullImage' | 'video' | 'closing' | 'article' | 'landing';
  bookTitle?: string;
  ctaLabel?: string;
  backgroundVideo?: string;
  backgroundImage?: string;
  heroImage?: string;
  imageAlt?: string;
  youtubeId?: string;
  summary?: string;
  externalLink?: LinkItem;
  externalLinks?: LinkItem[];
  order: number;
}

const TOTAL_PAGES = 9;

const {
  title,
  subtitle,
  layout,
  backgroundImage,
  heroImage,
  imageAlt,
  youtubeId,
  summary,
  externalLink,
  externalLinks,
  order,
  bookTitle,
  ctaLabel,
  backgroundVideo,
} = Astro.props;

const isFirst = order === 1;
const isLast = order === TOTAL_PAGES;
const prevHref = isFirst ? undefined : pageHref(order - 1);
const nextHref = isLast ? pageHref(1) : pageHref(order + 1);
const isFullBleed = layout === 'cover' || layout === 'fullImage' || layout === 'closing';
const isLanding = layout === 'landing';
const landingTitleLine2 = subtitle?.startsWith('與述說')
  ? {
      connector: '與',
      heading: '述說',
      detail: subtitle.slice('與述說'.length).trimStart(),
    }
  : subtitle
    ? { connector: '', heading: '', detail: subtitle }
    : null;
const landingCtaLabel = ctaLabel ?? '開始閱讀 →';
const publicAsset = (path: string) => {
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return `${base}${normalized}`.replace(/\/+/g, '/');
};
const bustedBackgroundVideo = backgroundVideo ? cacheBustUrl(publicAsset(backgroundVideo)) : undefined;
const BOOK_NAME = '豐榮渡風雨';
const pageTitle = title === BOOK_NAME ? title : `${title} — ${BOOK_NAME}`;
const bustedBackgroundImage = backgroundImage ? cacheBustUrl(backgroundImage) : undefined;
const bustedHeroImage = heroImage ? cacheBustUrl(heroImage) : undefined;
const fontStylesheet = cacheBustUrl(
  'https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Noto+Sans+TC:wght@400;600;700&display=swap'
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="豐榮渡風雨 — a ministry for underprivileged children in Cambodia." />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fontStylesheet} rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class={`layout-${layout}`}>
    <main class="page-shell" data-prev-href={prevHref} data-next-href={nextHref}>
      {isFullBleed && (
        <div
          class="page-bg"
          style={bustedBackgroundImage ? `background-image: url(${bustedBackgroundImage});` : undefined}
          role="img"
          aria-label={imageAlt}
        ></div>
      )}
      {isFullBleed && <div class="page-overlay"></div>}

      {!isLanding && (
        <div class="page-decor" aria-hidden="true">
          <span class="decor-blob"></span>
          <span class="decor-strip"></span>
        </div>
      )}

      {isLanding && bustedBackgroundVideo && (
        <div class="landing-hero-bg" aria-hidden="true">
          <video
            class="landing-hero-video"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            disablepictureinpicture
          >
            <source src={bustedBackgroundVideo} type="video/mp4" />
          </video>
        </div>
      )}

      {isLanding ? (
        <div class="landing-layout">
          <div class="landing-content">
            <div class="landing-text">
              <header class="landing-header">
                <h1 class="landing-title-line1">{title}</h1>
                {landingTitleLine2 && (
                  <p class="landing-title-line2">
                    {landingTitleLine2.connector && (
                      <span class="landing-title-connector">{landingTitleLine2.connector}</span>
                    )}
                    {landingTitleLine2.heading && (
                      <span class="landing-title-heading">{landingTitleLine2.heading}</span>
                    )}
                    {landingTitleLine2.detail && (
                      <span class="landing-title-detail">{landingTitleLine2.detail}</span>
                    )}
                  </p>
                )}
              </header>
              <div class="landing-details prose">
                <slot />
              </div>
              {bookTitle && <p class="landing-book-title">{bookTitle}</p>}
              {nextHref && (
                <div class="landing-actions link-row">
                  <a class="btn-link" href={nextHref}>{landingCtaLabel}</a>
                </div>
              )}
            </div>
          </div>
        </div>
      ) : (
        <div class="page-content">
          <header class={isFullBleed ? 'page-header title-plate' : 'page-header'}>
            <h1>{title}</h1>
            {subtitle && <p class="subtitle">{subtitle}</p>}
          </header>

          <div class="page-body">
            {heroImage && (
              <img
                class="hero-image"
                src={bustedHeroImage}
                alt={imageAlt || ''}
                loading="lazy"
                onerror="this.style.display='none'"
              />
            )}

            {layout === 'video' && youtubeId && <YouTubeEmbed id={youtubeId} title={title} />}

            {layout === 'article' ? (
              <>
                {summary && <p class="summary-text">{summary}</p>}
                <button
                  type="button"
                  class="read-more-btn"
                  data-read-more
                  aria-expanded="false"
                  aria-controls={`article-collapse-${order}`}
                >
                  Read more ↓
                </button>
                <div class="reveal-collapse" id={`article-collapse-${order}`}>
                  <div class="reveal-inner prose">
                    <slot />
                  </div>
                </div>
              </>
            ) : (
              <div class="prose">
                <slot />
              </div>
            )}

            {externalLink && (
              <div class="link-row">
                <ExternalLink label={externalLink.label} url={externalLink.url} />
              </div>
            )}

            {externalLinks && externalLinks.length > 0 && (
              <div class="link-row">
                {externalLinks.map((link) => (
                  <ExternalLink label={link.label} url={link.url} />
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </main>

    <NavDock prevHref={prevHref} nextHref={nextHref} current={order} total={TOTAL_PAGES} isLast={isLast} />

    <script>
      import { navigate } from 'astro:transitions/client';

      function setupSwipeNav() {
        const shell = document.querySelector('.page-shell');
        if (!(shell instanceof HTMLElement)) return;

        const SWIPE_THRESHOLD = 60;
        let startX = 0;
        let startY = 0;

        shell.addEventListener(
          'touchstart',
          (e) => {
            const touch = e.touches[0];
            startX = touch.clientX;
            startY = touch.clientY;
          },
          { passive: true }
        );

        shell.addEventListener(
          'touchend',
          (e) => {
            const touch = e.changedTouches[0];
            const dx = touch.clientX - startX;
            const dy = touch.clientY - startY;

            if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy) * 1.5) return;

            const nextHref = shell.dataset.nextHref;
            const prevHref = shell.dataset.prevHref;

            if (dx < 0 && nextHref) {
              navigate(nextHref);
            } else if (dx > 0 && prevHref) {
              navigate(prevHref);
            }
          },
          { passive: true }
        );
      }

      function setupReadMore() {
        document.querySelectorAll('[data-read-more]').forEach((btn) => {
          if (!(btn instanceof HTMLElement)) return;
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('aria-controls');
            const target = targetId ? document.getElementById(targetId) : null;
            if (!target) return;

            const expanded = target.classList.toggle('is-expanded');
            btn.setAttribute('aria-expanded', String(expanded));
            btn.textContent = expanded ? 'Read less ↑' : 'Read more ↓';
          });
        });
      }

      setupSwipeNav();
      setupReadMore();
      setupLandingVideo();
      setupLandingVideoResume();
      setupReadMoreDialog();
      document.addEventListener('astro:page-load', setupSwipeNav);
      document.addEventListener('astro:page-load', setupReadMore);
      document.addEventListener('astro:page-load', setupLandingVideo);
      document.addEventListener('astro:page-load', setupLandingVideoResume);
      document.addEventListener('astro:page-load', setupReadMoreDialog);

      function setupReadMoreDialog() {
        if (document.documentElement.dataset.readMoreDialogReady) return;
        document.documentElement.dataset.readMoreDialogReady = 'true';

        document.addEventListener('click', (e) => {
          const target = e.target;
          if (!(target instanceof Element)) return;

          const openBtn = target.closest('[data-read-more-open]');
          if (openBtn instanceof HTMLElement) {
            const id = openBtn.getAttribute('data-read-more-open');
            const dialog = id ? document.getElementById(id) : null;
            if (dialog instanceof HTMLDialogElement) {
              dialog.showModal();
              activateDialogVideos(dialog);
            }
            return;
          }

          const closeBtn = target.closest('[data-read-more-close]');
          if (closeBtn instanceof HTMLElement) {
            const id = closeBtn.getAttribute('data-read-more-close');
            const dialog = id ? document.getElementById(id) : null;
            if (dialog instanceof HTMLDialogElement) dialog.close();
            return;
          }

          if (target instanceof HTMLDialogElement && target.classList.contains('read-more-dialog')) {
            target.close();
          }
        });
      }

      function activateDialogVideos(dialog: HTMLDialogElement) {
        dialog.querySelectorAll('.video-wrapper iframe').forEach((iframe) => {
          if (!(iframe instanceof HTMLIFrameElement)) return;
          const src = iframe.getAttribute('src');
          if (!src) return;
          iframe.src = '';
          iframe.src = src;
        });
      }

      function setupLandingVideo() {
        document.querySelectorAll('.landing-hero-video').forEach((video) => {
          if (!(video instanceof HTMLVideoElement)) return;

          video.muted = true;
          video.defaultMuted = true;
          video.setAttribute('muted', '');
          video.setAttribute('playsinline', '');
          video.setAttribute('webkit-playsinline', '');

          const play = () => {
            video.muted = true;
            video.play().catch(() => {});
          };

          play();

          if (video.readyState < HTMLMediaElement.HAVE_CURRENT_DATA) {
            video.addEventListener('loadeddata', play, { once: true });
            video.addEventListener('canplay', play, { once: true });
          }
        });
      }

      function setupLandingVideoResume() {
        const resume = () => setupLandingVideo();

        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible') resume();
        });

        window.addEventListener('pageshow', resume);
        document.addEventListener('touchstart', resume, { once: true, passive: true });
      }
    </script>
  </body>
</html>
