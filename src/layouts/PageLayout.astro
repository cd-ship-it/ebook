---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import NavControls from '../components/NavControls.astro';
import ExternalLink from '../components/ExternalLink.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

interface LinkItem {
  label: string;
  url: string;
}

interface Props {
  title: string;
  subtitle?: string;
  layout: 'cover' | 'content' | 'fullImage' | 'video' | 'closing';
  backgroundImage?: string;
  heroImage?: string;
  imageAlt?: string;
  youtubeId?: string;
  externalLink?: LinkItem;
  externalLinks?: LinkItem[];
  order: number;
}

const TOTAL_PAGES = 8;

const {
  title,
  subtitle,
  layout,
  backgroundImage,
  heroImage,
  imageAlt,
  youtubeId,
  externalLink,
  externalLinks,
  order,
} = Astro.props;

const isFirst = order === 1;
const isLast = order === TOTAL_PAGES;
const prevHref = isFirst ? undefined : `/page${order - 1}.html`;
const nextHref = isLast ? '/page1.html' : `/page${order + 1}.html`;
const isFullBleed = layout === 'cover' || layout === 'fullImage' || layout === 'closing';
const BOOK_NAME = '豐榮渡風雨';
const pageTitle = title === BOOK_NAME ? title : `${title} — ${BOOK_NAME}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="豐榮渡風雨 — a ministry for underprivileged children in Cambodia." />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&family=Noto+Sans+TC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class={`layout-${layout}`}>
    {prevHref ? (
      <a class="side-nav side-nav-prev" href={prevHref} aria-label="Previous page">
        <span>‹ Prev</span>
      </a>
    ) : (
      <span class="side-nav side-nav-prev is-disabled" aria-hidden="true">
        <span>‹ Prev</span>
      </span>
    )}
    <a class="side-nav side-nav-next" href={nextHref} aria-label={isLast ? 'Restart' : 'Next page'}>
      <span>{isLast ? 'Restart' : 'Next ›'}</span>
    </a>

    <main class="page-shell" data-prev-href={prevHref} data-next-href={nextHref}>
      {isFullBleed && (
        <div
          class="page-bg"
          style={backgroundImage ? `background-image: url(${backgroundImage});` : undefined}
          role="img"
          aria-label={imageAlt}
        ></div>
      )}
      {isFullBleed && <div class="page-overlay"></div>}

      <div class="page-decor" aria-hidden="true">
        <span class="decor-blob"></span>
        <span class="decor-strip"></span>
      </div>

      <div class="page-content">
        <header class={isFullBleed ? 'page-header title-plate' : 'page-header'}>
          <h1>{title}</h1>
          {subtitle && <p class="subtitle">{subtitle}</p>}
        </header>

        <div class="page-body">
          {!isFullBleed && heroImage && (
            <img
              class="hero-image"
              src={heroImage}
              alt={imageAlt || ''}
              loading="lazy"
              onerror="this.style.display='none'"
            />
          )}

          {layout === 'video' && youtubeId && <YouTubeEmbed id={youtubeId} title={title} />}

          <div class="prose">
            <slot />
          </div>

          {externalLink && (
            <div class="link-row">
              <ExternalLink label={externalLink.label} url={externalLink.url} />
            </div>
          )}

          {externalLinks && externalLinks.length > 0 && (
            <div class="link-row">
              {externalLinks.map((link) => (
                <ExternalLink label={link.label} url={link.url} />
              ))}
            </div>
          )}
        </div>

        <NavControls prevHref={prevHref} nextHref={nextHref} current={order} total={TOTAL_PAGES} isLast={isLast} />
      </div>
    </main>

    <script>
      import { navigate } from 'astro:transitions/client';

      function setupSwipeNav() {
        const shell = document.querySelector('.page-shell');
        if (!(shell instanceof HTMLElement)) return;

        const SWIPE_THRESHOLD = 60;
        let startX = 0;
        let startY = 0;

        shell.addEventListener(
          'touchstart',
          (e) => {
            const touch = e.touches[0];
            startX = touch.clientX;
            startY = touch.clientY;
          },
          { passive: true }
        );

        shell.addEventListener(
          'touchend',
          (e) => {
            const touch = e.changedTouches[0];
            const dx = touch.clientX - startX;
            const dy = touch.clientY - startY;

            if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy) * 1.5) return;

            const nextHref = shell.dataset.nextHref;
            const prevHref = shell.dataset.prevHref;

            if (dx < 0 && nextHref) {
              navigate(nextHref);
            } else if (dx > 0 && prevHref) {
              navigate(prevHref);
            }
          },
          { passive: true }
        );
      }

      setupSwipeNav();
      document.addEventListener('astro:page-load', setupSwipeNav);
    </script>
  </body>
</html>
