---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageContent from '../components/PageContent.astro';

const entry = await getEntry('pages', 'page-1');
if (!entry) throw new Error('Missing content entry: page-1');

const {
  title,
  subtitle,
  layout,
  backgroundImage,
  heroImage,
  imageAlt,
  youtubeId,
  externalLink,
  externalLinks,
  order,
  summary,
  bookTitle,
  ctaLabel,
  backgroundVideo,
  readMoreLabel,
} = entry.data;
---

<PageLayout
  title={title}
  subtitle={subtitle}
  layout={layout}
  backgroundImage={backgroundImage}
  heroImage={heroImage}
  imageAlt={imageAlt}
  youtubeId={youtubeId}
  summary={summary}
  externalLink={externalLink}
  externalLinks={externalLinks}
  order={order}
  bookTitle={bookTitle}
  ctaLabel={ctaLabel}
  backgroundVideo={backgroundVideo}
>
  <PageContent body={entry.body ?? ''} pageOrder={order} readMoreLabel={readMoreLabel} />
</PageLayout>
