---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import MarkdownBlocks from '../components/MarkdownBlocks.astro';
import { parseMarkdownBlocks } from '../utils/parseMarkdownBlocks';
import { splitPageMarkdown } from '../utils/pageMarkdown';

const entry = await getEntry('pages', 'page-1');
if (!entry) throw new Error('Missing content entry: page-1');

const { main, details } = splitPageMarkdown(entry.body ?? '');

const {
  title,
  subtitle,
  layout,
  backgroundImage,
  heroImage,
  imageAlt,
  youtubeId,
  externalLink,
  externalLinks,
  order,
  summary,
  bookTitle,
  ctaLabel,
  backgroundVideo,
  readMoreLabel,
} = entry.data;

const mainBlocks = parseMarkdownBlocks(main, order);
const readMoreBlocks = details ? parseMarkdownBlocks(details, order) : [];
---

<PageLayout
  title={title}
  subtitle={subtitle}
  layout={layout}
  backgroundImage={backgroundImage}
  heroImage={heroImage}
  imageAlt={imageAlt}
  youtubeId={youtubeId}
  summary={summary}
  externalLink={externalLink}
  externalLinks={externalLinks}
  order={order}
  bookTitle={bookTitle}
  ctaLabel={ctaLabel}
  backgroundVideo={backgroundVideo}
  readMoreLabel={readMoreLabel}
  readMoreBlocks={readMoreBlocks}
>
  <MarkdownBlocks blocks={mainBlocks} pageOrder={order} />
</PageLayout>
