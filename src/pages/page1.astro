---
export const prerender = true;
import { pageHref } from '../utils/paths';

const homePage = pageHref(1);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${homePage}`} />
    <link rel="canonical" href={homePage} />
    <title>豐榮渡風雨</title>
    <script is:inline define:vars={{ homePage }}>
      window.location.replace(homePage);
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={homePage}>the book</a>&hellip;</p>
  </body>
</html>
