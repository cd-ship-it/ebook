---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageContent from '../components/PageContent.astro';

const entry = await getEntry('pages', 'page-5');
if (!entry) throw new Error('Missing content entry: page-5');
const { title, subtitle, layout, backgroundImage, heroImage, imageAlt, youtubeId, externalLink, externalLinks, order, summary } = entry.data;
---

<PageLayout
  title={title}
  subtitle={subtitle}
  layout={layout}
  backgroundImage={backgroundImage}
  heroImage={heroImage}
  imageAlt={imageAlt}
  youtubeId={youtubeId}
  summary={summary}
  externalLink={externalLink}
  externalLinks={externalLinks}
  order={order}
>
  <PageContent body={entry.body ?? ''} pageOrder={order} />
</PageLayout>
