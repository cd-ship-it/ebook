---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'page-5');
if (!entry) throw new Error('Missing content entry: page-5');
const { Content } = await render(entry);
const { title, subtitle, layout, backgroundImage, heroImage, imageAlt, youtubeId, externalLink, externalLinks, order, summary } = entry.data;
---

<PageLayout
  title={title}
  subtitle={subtitle}
  layout={layout}
  backgroundImage={backgroundImage}
  heroImage={heroImage}
  imageAlt={imageAlt}
  youtubeId={youtubeId}
  summary={summary}
  externalLink={externalLink}
  externalLinks={externalLinks}
  order={order}
>
  <Content />
</PageLayout>
